# Local-only Langfuse secrets (git-ignored). Regenerate freely before first start.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/postgres
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
SALT=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# Shared server: publish on every interface and use the address clients reach.
# LANGFUSE_BIND=0.0.0.0
# NEXTAUTH_URL=http://<server>:3100
# LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://<server>:9190
# LANGFUSE_S3_BATCH_EXPORT_EXTERNAL_ENDPOINT=http://<server>:9190

# Headless bootstrap: org, project, API keys and a local login.
LANGFUSE_INIT_ORG_ID=frontier
LANGFUSE_INIT_ORG_NAME=FrontierAgent
LANGFUSE_INIT_PROJECT_ID=frontier-agent
LANGFUSE_INIT_PROJECT_NAME=frontier-agent
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-
LANGFUSE_INIT_USER_EMAIL=admin@frontier.local
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=
